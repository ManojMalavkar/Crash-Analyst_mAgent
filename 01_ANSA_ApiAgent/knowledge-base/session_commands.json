[
  {
    "command": "open",
    "category": "file_io",
    "syntax": "open <filepath>",
    "description": "Open a result file (d3plot, binout, or keyword) for post-processing",
    "parameters": {
      "filepath": "Path to the result file (d3plot, d3thdt, binout, .key)"
    },
    "examples": [
      "open /results/crash_01/d3plot",
      "open /results/simulation.binout"
    ]
  },
  {
    "command": "close",
    "category": "file_io",
    "syntax": "close [all]",
    "description": "Close the current result file or all open files",
    "parameters": {
      "all": "Optional: close all open files"
    },
    "examples": ["close", "close all"]
  },
  {
    "command": "save",
    "category": "file_io",
    "syntax": "save <filepath> [format=<fmt>]",
    "description": "Save current view as image file",
    "parameters": {
      "filepath": "Output file path",
      "format": "Image format: png, jpg, bmp, tiff, pdf"
    },
    "examples": [
      "save /output/front_view.png format=png",
      "save /output/report.pdf format=pdf"
    ]
  },
  {
    "command": "export",
    "category": "file_io",
    "syntax": "export <filepath> format=<fmt>",
    "description": "Export data or images in specified format",
    "parameters": {
      "filepath": "Output file path",
      "format": "Export format: png, jpg, csv, avi, gif"
    },
    "examples": [
      "export /output/animation.avi format=avi",
      "export /output/curve_data.csv format=csv"
    ]
  },
  {
    "command": "contour",
    "category": "display",
    "syntax": "contour <component> [min=<val>] [max=<val>]",
    "description": "Display fringe/contour plot of a result component",
    "parameters": {
      "component": "Result component: von_mises, plastic_strain, displacement, velocity, acceleration",
      "min": "Optional minimum value for color scale",
      "max": "Optional maximum value for color scale"
    },
    "examples": [
      "contour von_mises",
      "contour plastic_strain min=0 max=0.3",
      "contour displacement"
    ]
  },
  {
    "command": "fringe",
    "category": "display",
    "syntax": "fringe <component> [parts=<list>]",
    "description": "Display fringe plot on selected parts",
    "parameters": {
      "component": "Result component to display",
      "parts": "Optional comma-separated part IDs to display on"
    },
    "examples": [
      "fringe von_mises parts=1,2,3",
      "fringe plastic_strain"
    ]
  },
  {
    "command": "deform",
    "category": "display",
    "syntax": "deform [scale=<factor>] [mode=<actual|scaled>]",
    "description": "Apply deformation display to the model",
    "parameters": {
      "scale": "Deformation scale factor (default=1.0, use >1 for exaggeration)",
      "mode": "actual (real scale) or scaled (magnified)"
    },
    "examples": [
      "deform scale=1.0",
      "deform scale=10 mode=scaled"
    ]
  },
  {
    "command": "view",
    "category": "display",
    "syntax": "view <preset>",
    "description": "Set camera to a predefined view angle",
    "parameters": {
      "preset": "View name: front, back, top, bottom, left, right, iso"
    },
    "examples": ["view front", "view iso", "view top"]
  },
  {
    "command": "rotate",
    "category": "display",
    "syntax": "rotate axis=<x|y|z> angle=<degrees>",
    "description": "Rotate the view around an axis",
    "parameters": {
      "axis": "Rotation axis: x, y, or z",
      "angle": "Rotation angle in degrees"
    },
    "examples": ["rotate axis=z angle=45", "rotate axis=y angle=90"]
  },
  {
    "command": "zoom",
    "category": "display",
    "syntax": "zoom [factor=<val>] [fit]",
    "description": "Zoom in/out or fit model to window",
    "parameters": {
      "factor": "Zoom factor (>1 zoom in, <1 zoom out)",
      "fit": "Fit entire model in view"
    },
    "examples": ["zoom factor=2.0", "zoom fit"]
  },
  {
    "command": "state",
    "category": "model",
    "syntax": "state <number>",
    "description": "Set the current time state (frame number) for display",
    "parameters": {
      "number": "State/frame number (1-based)"
    },
    "examples": ["state 1", "state 50", "state last"]
  },
  {
    "command": "timestep",
    "category": "model",
    "syntax": "timestep <value>",
    "description": "Jump to a specific simulation time",
    "parameters": {
      "value": "Time value in simulation units (e.g., milliseconds)"
    },
    "examples": ["timestep 0.0", "timestep 50.0", "timestep 120.0"]
  },
  {
    "command": "animate",
    "category": "animation",
    "syntax": "animate start=<n> end=<n> [step=<n>] [loop=<bool>]",
    "description": "Create animation over a range of states",
    "parameters": {
      "start": "Starting state number",
      "end": "Ending state number",
      "step": "State increment (default=1)",
      "loop": "Loop animation (true/false)"
    },
    "examples": [
      "animate start=1 end=100 step=1",
      "animate start=1 end=50 step=2 loop=true"
    ]
  },
  {
    "command": "record",
    "category": "animation",
    "syntax": "record <output_path> format=<avi|gif> [fps=<n>] [resolution=<WxH>]",
    "description": "Record animation to video file",
    "parameters": {
      "output_path": "Output video file path",
      "format": "Video format: avi, gif, mp4",
      "fps": "Frames per second (default=24)",
      "resolution": "Video resolution WxH (e.g., 1920x1080)"
    },
    "examples": [
      "record /output/crash_anim.avi format=avi fps=30",
      "record /output/deform.gif format=gif resolution=800x600"
    ]
  },
  {
    "command": "curve",
    "category": "data_extraction",
    "syntax": "curve entity=<id> component=<name> [vs=time]",
    "description": "Extract time-history curve data from an entity",
    "parameters": {
      "entity": "Entity ID (node, element, part, or cross-section ID)",
      "component": "Data component: displacement_x, velocity_y, force_z, energy, etc.",
      "vs": "X-axis variable (default: time)"
    },
    "examples": [
      "curve entity=12345 component=displacement_x",
      "curve entity=section_1 component=force_z vs=time"
    ]
  },
  {
    "command": "section",
    "category": "data_extraction",
    "syntax": "section origin=(<x>,<y>,<z>) normal=(<nx>,<ny>,<nz>) [name=<str>]",
    "description": "Create a cross-section plane for force/moment extraction",
    "parameters": {
      "origin": "Section plane origin point (x,y,z)",
      "normal": "Section plane normal vector (nx,ny,nz)",
      "name": "Optional section name"
    },
    "examples": [
      "section origin=(0,500,0) normal=(0,1,0) name=B_pillar",
      "section origin=(1000,0,300) normal=(1,0,0)"
    ]
  },
  {
    "command": "measure",
    "category": "data_extraction",
    "syntax": "measure <type> entity=<id> [entity2=<id>]",
    "description": "Measure distance, intrusion, or deformation between entities",
    "parameters": {
      "type": "Measurement type: distance, intrusion, angle",
      "entity": "First entity ID",
      "entity2": "Second entity ID (for distance/angle)"
    },
    "examples": [
      "measure distance entity=1001 entity2=2002",
      "measure intrusion entity=5000"
    ]
  },
  {
    "command": "select",
    "category": "selection",
    "syntax": "select <target> [filter=<condition>]",
    "description": "Select entities by type or filter condition",
    "parameters": {
      "target": "What to select: all, none, parts, nodes, elements, by_id, by_property",
      "filter": "Optional filter condition"
    },
    "examples": [
      "select parts filter=material_id=24",
      "select all",
      "select none"
    ]
  },
  {
    "command": "text",
    "category": "annotation",
    "syntax": "text '<content>' position=(<x>,<y>) [size=<n>] [color=<name>]",
    "description": "Add text annotation to the current view",
    "parameters": {
      "content": "Text string to display",
      "position": "Screen position (x,y) in normalized coords (0-1)",
      "size": "Font size (default=12)",
      "color": "Text color name or RGB"
    },
    "examples": [
      "text 'Frontal Impact @ 50ms' position=(0.1,0.9) size=14",
      "text 'Max stress: 450 MPa' position=(0.5,0.05)"
    ]
  },
  {
    "command": "window",
    "category": "window",
    "syntax": "window layout=<n> [active=<n>]",
    "description": "Set window layout (number of viewports)",
    "parameters": {
      "layout": "Number of windows: 1, 2, 4, 6, 9",
      "active": "Set active window number"
    },
    "examples": [
      "window layout=4",
      "window layout=2 active=1"
    ]
  },
  {
    "command": "iso",
    "category": "display",
    "syntax": "iso component=<name> value=<threshold>",
    "description": "Create isosurface at a threshold value",
    "parameters": {
      "component": "Result component for isosurface",
      "value": "Threshold value"
    },
    "examples": [
      "iso component=plastic_strain value=0.05",
      "iso component=von_mises value=200"
    ]
  },
  {
    "command": "filter",
    "category": "selection",
    "syntax": "filter <criterion> [threshold=<val>]",
    "description": "Filter displayed elements by result value",
    "parameters": {
      "criterion": "Filter criterion: above, below, between, equals",
      "threshold": "Filter threshold value"
    },
    "examples": [
      "filter above threshold=0.1",
      "filter below threshold=500"
    ]
  },
  {
    "command": "title",
    "category": "annotation",
    "syntax": "title '<text>'",
    "description": "Set the plot title",
    "parameters": {
      "text": "Title text string"
    },
    "examples": [
      "title 'Euro NCAP - Full Frontal Impact'",
      "title 'Plastic Strain at T=100ms'"
    ]
  },
  {
    "command": "legend",
    "category": "annotation",
    "syntax": "legend [visible=<bool>] [position=<loc>]",
    "description": "Show/hide and position the color legend",
    "parameters": {
      "visible": "Show (true) or hide (false) the legend",
      "position": "Legend position: left, right, top, bottom"
    },
    "examples": ["legend visible=true position=right", "legend visible=false"]
  },
  {
    "command": "energy",
    "category": "data_extraction",
    "syntax": "energy [type=<kinetic|internal|total|hourglass>] [parts=<ids>]",
    "description": "Extract energy time-history curves",
    "parameters": {
      "type": "Energy type: kinetic, internal, total, hourglass, sliding",
      "parts": "Optional part IDs to scope (comma-separated)"
    },
    "examples": [
      "energy type=kinetic",
      "energy type=internal parts=1,2,3",
      "energy type=hourglass"
    ]
  }
]
