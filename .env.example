# ==============================================================================
# SafetyAgent — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# --- LLM Configuration ---
LLM_API_KEY=your-api-key-here
LLM_API_BASE_URL=https://your-workspace.databricks.net/serving-endpoints
LLM_PRIMARY_MODEL=claude-sonnet-4-20250514
LLM_FALLBACK_1=llama-3-70b-instruct
LLM_FALLBACK_2=llama-3-8b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=120

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=64

# --- Agent Settings ---
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_CONTEXT_MESSAGES=20
AGENT_RETRIEVAL_TOP_K=5
AGENT_RETRIEVAL_THRESHOLD=0.7
AGENT_CODE_REVIEW=true

# --- UI Settings ---
UI_HOST=0.0.0.0
UI_PORT=7860
UI_SHARE=false
UI_THEME=soft

# --- General ---
DEBUG=false
